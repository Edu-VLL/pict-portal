# ---- Portal ----
# Publishable key (pk_...) — safe in the browser bundle.
NEXT_PUBLIC_PORTAL_KEY=
# Secret key (sk_...) — server only. NEVER prefix with NEXT_PUBLIC and NEVER commit.
PORTAL_SECRET=
# ---- AI vision (for the AI guesser) ----
# Anthropic API key used server-side by /api/guess. Never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...
# Vision-capable model. Override if you have a newer one available on your key.
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

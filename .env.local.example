# ---- Portal ----
# Publishable key (pk_...) — safe in the browser bundle.
NEXT_PUBLIC_PORTAL_KEY=
# Secret key (sk_...) — server only. NEVER prefix with NEXT_PUBLIC and NEVER commit.
PORTAL_SECRET=
# ---- AI vision (for the AI guesser) ----
# Google AI Studio (Gemini) key used server-side by /api/guess. Never exposed to
# the browser. Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Vision-capable Gemini model; leave unset to use the default below.
# Must be a Gemini model id — an Anthropic/OpenAI model name here 404s.
GEMINI_MODEL=gemini-flash-lite-latest
